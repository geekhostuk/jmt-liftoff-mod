<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <AssemblyName>JmtLiftoffMod</AssemblyName>
    <RootNamespace>JmtLiftoffMod</RootNamespace>
    <AssemblyTitle>JMT Liftoff Mod</AssemblyTitle>
    <Description>BepInEx plugin that turns a copy of Liftoff into a server-driven multiplayer race host with gate-by-gate timing.</Description>
  </PropertyGroup>

  <!-- Generate BuildInfo from the version in Directory.Build.props, so the version
       lives in exactly one place. Plugin.PluginVersion / Plugin.BuildMarker read these. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <!-- IntermediateOutputPath is only set once the SDK targets have been imported,
         so this has to be resolved inside the target, not in a top-level PropertyGroup. -->
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <BuildInfoSource>
<![CDATA[// <auto-generated /> Written by the GenerateBuildInfo target — do not edit, do not commit.
namespace JmtLiftoffMod%3B

internal static class BuildInfo
{
    public const string Version = "$(Version)"%3B
    public const string Marker = "$(Version)+$(BuildRevision)"%3B
}
]]>
      </BuildInfoSource>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="$(BuildInfoSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Set LIFTOFF_DIR environment variable to override the default Liftoff install path -->
  <PropertyGroup>
    <LIFTOFF_DIR Condition="'$(LIFTOFF_DIR)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Liftoff</LIFTOFF_DIR>
  </PropertyGroup>

  <!-- Set BEPINEX_CORE_DIR environment variable to override auto-detection.
       Probes both BepInEx (active) and _BepInEx (renamed/disabled) install folders. -->
  <PropertyGroup>
    <BEPINEX_CORE_DIR Condition="'$(BEPINEX_CORE_DIR)' == '' And Exists('$(LIFTOFF_DIR)\BepInEx\core\BepInEx.dll')">$(LIFTOFF_DIR)\BepInEx\core</BEPINEX_CORE_DIR>
    <BEPINEX_CORE_DIR Condition="'$(BEPINEX_CORE_DIR)' == '' And Exists('$(LIFTOFF_DIR)\_BepInEx\core\BepInEx.dll')">$(LIFTOFF_DIR)\_BepInEx\core</BEPINEX_CORE_DIR>
  </PropertyGroup>

  <Target Name="CheckBepInEx" BeforeTargets="Build">
    <Warning Condition="!Exists('$(BEPINEX_CORE_DIR)\BepInEx.dll')" Text="BepInEx not found at '$(BEPINEX_CORE_DIR)'. Set LIFTOFF_DIR environment variable to your Liftoff install folder." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BEPINEX_CORE_DIR)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(BEPINEX_CORE_DIR)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.UI">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="PhotonRealtime">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Photon3Unity3D">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="ExitGames.Client.Photon">
      <HintPath>$(LIFTOFF_DIR)\Liftoff_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
